CompileFlags:
  Add: 
    - -DPICO_BOARD=pico
    - -DPICO_RP2040=1
    - -DPICO_NO_HARDWARE=0
    - -I$PICO_SDK_PATH/src
    - -I$PICO_SDK_PATH/src/common/include
    - -I$PICO_SDK_PATH/src/rp2_common/include
    - -I$PICO_SDK_PATH/src/rp2040/include
    - -I$PICO_SDK_PATH/lib/tinyusb/src
    - -I/usr/include/newlib
    - --target=arm-none-eabi
    - -D__RP2040__
  CompilationDatabase: build
